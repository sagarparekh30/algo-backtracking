# ============================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env to git.
# ============================================================

# ── Fyers API credentials ────────────────────────────────────
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_REDIRECT_URI=https://www.google.com

# ── PostgreSQL ───────────────────────────────────────────────
# Docker Compose default (db service):
DATABASE_URL=postgresql://trading:trading@db:5432/trading
# Local development (if running without Docker):
# DATABASE_URL=postgresql://trading:trading@localhost:5432/trading

# ── Data fetch settings ──────────────────────────────────────
LOOKBACK_YEARS=10
DAILY_LOOKBACK_DAYS=10

# ── Auto-scheduler ───────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_DATA_UPDATE_TIME=16:00
SCHEDULER_ML_RETRAIN_DAY=sun
SCHEDULER_ML_RETRAIN_TIME=22:00

# ── Risk management ──────────────────────────────────────────
INITIAL_CAPITAL=500000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=10
ATR_PERIOD=14
ATR_MULTIPLIER=2.0
REWARD_RISK_RATIO=2.0
MAX_HOLD_DAYS=20

# ── Telegram alerts (optional) ───────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Logging ──────────────────────────────────────────────────
LOG_DIR=/app/logs
